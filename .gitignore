# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment variables & secrets
.env
.env.local
.env.*.local
secrets.json

# Large datasets & raw data downloads (preserve structure with .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.zip
*.tar.gz

# Model weights & vector store indices
*.bin
*.pt
*.safetensors
*.onnx
*.faiss
*.chromadb/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Testing & code coverage
.pytest_cache/
.coverage
htmlcov/

# Build & distribution
build/
dist/
*.egg-info/

# IDE & OS-specific files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.log
